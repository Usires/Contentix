# ─── YouTube Data API v3 MCP Server ──────────────────────────────────────────
#
# This file lives at mcp-servers/youtube/.env.example
# Copy to .env and fill in real values.

# ─── Required: API Key (for public data: any channel, any video) ────────────
# Create at: https://console.cloud.google.com/apis/credentials
# → "+ Create Credentials" → "API key"
# Restrict it to "YouTube Data API v3" for safety.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ─── Required for OAuth (for own channel: analytics, watchtime, real-time) ──
# Create at: https://console.cloud.google.com/apis/credentials
# → "+ Create Credentials" → "OAuth client ID" → Application type "Desktop app"
# → Authorized redirect URI: http://localhost:8190/auth/callback
GOOGLE_CLIENT_ID=your_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here

# ─── Optional ───────────────────────────────────────────────────────────────
MCP_PORT=8190
